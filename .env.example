EXPO_PUBLIC_SUPABASE_URL=your-expo-public-supabase-url
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-expo-public-supabase-publishable-key

# Public Google OAuth IDs (never put a client secret in this frontend).
# Use the WEB client ID as the ID-token audience for Android and the web GIS button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-expo-public-google-web-client-id
# Optional until Google sign-in is tested in an iOS build. The config derives its URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-expo-public-google-ios-client-id
# Android additionally needs com.wenitro.app + each build's signing SHA-1 registered
# in Google Cloud. Register the accepted client IDs and enable Google in Supabase.
# Native sign-in requires an installed development/release build, not Expo Go.
